---
// Small line icons for facts (guests, bed). They inherit the text colour and are
// decorative: pair them with visible or visually hidden text.
interface Props {
  name: 'person' | 'bed';
}

const { name } = Astro.props;
---

<svg class="icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
  {
    name === 'person' && (
      <>
        <circle cx="8" cy="5" r="2.75" stroke="currentColor" stroke-width="1.3" />
        <path d="M2.75 14.5a5.25 5.25 0 0 1 10.5 0" stroke="currentColor" stroke-width="1.3" />
      </>
    )
  }
  {
    name === 'bed' && (
      <>
        {/* Double bed: headboard, two pillows, mattress, legs. */}
        <path d="M1.5 3.5v10M1.5 10.5h13v3M1.5 8h13v2.5" stroke="currentColor" stroke-width="1.3" />
        <path d="M3.5 5.75h4v2.25h-4zM8.5 5.75h4v2.25h-4z" stroke="currentColor" stroke-width="1.1" />
      </>
    )
  }
</svg>
