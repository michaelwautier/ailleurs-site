---
import CalendarIcon from './CalendarIcon.astro';
import { houses } from '../data/houses';
import { withBase } from '../lib/url';

interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
---

<header class="site-header" id="top" transition:persist>
  <a class="brand" href={withBase('/')} aria-label="Accueil Ailleurs">
    <span class="brand-name">Ailleurs</span>
    <span class="brand-sub">Maisons d'univers</span>
  </a>
  <nav class="tabs" aria-label="Logements">
    {
      houses.map((house) => (
        <a
          class="tab"
          href={withBase(`/maisons/${house.slug}`)}
          aria-current={house.slug === activeSlug ? 'page' : undefined}
          aria-label={`${house.word} — ${house.meaning} (${house.tab})`}
        >
          <span class="tab-word">
            <span class="tab-index">{house.index}</span>
            <span style={`font-family:${house.theme.font}`}>{house.word}</span>
          </span>
          <span class="tab-sub">
            <span lang={house.lang} dir={house.dir} style={`font-family:${house.nativeFont}`}>
              {house.native}
            </span>
            <span>· {house.meaning}</span>
          </span>
        </a>
      ))
    }
    <span class="tabs-indicator" aria-hidden="true"></span>
  </nav>
  <a class="pill" href="#reserver"><CalendarIcon />Réserver</a>
</header>

<script>
  // The header persists across view transitions, so its active tab is synced
  // manually, and a single underline slides from the previous tab to the new one.
  function syncActiveTab() {
    const path = window.location.pathname.replace(/\/$/, '');
    document.querySelectorAll<HTMLAnchorElement>('.site-header .tab').forEach((tab) => {
      const isActive = tab.pathname.replace(/\/$/, '') === path;
      if (isActive) tab.setAttribute('aria-current', 'page');
      else tab.removeAttribute('aria-current');
    });
  }

  function placeIndicator(animate: boolean) {
    const indicator = document.querySelector<HTMLElement>('.tabs-indicator');
    if (!indicator) return;
    const active = document.querySelector<HTMLElement>('.site-header .tab[aria-current="page"]');
    if (!active) {
      indicator.classList.remove('is-visible');
      return;
    }
    // Slide only from a visible position; coming from the home page it just appears.
    const slide = animate && indicator.classList.contains('is-visible');
    if (!slide) indicator.style.transition = 'none';
    indicator.style.width = `${active.offsetWidth}px`;
    indicator.style.transform = `translateX(${active.offsetLeft}px)`;
    indicator.classList.add('is-visible');
    if (!slide) {
      void indicator.offsetWidth; // apply the jump before restoring transitions
      indicator.style.transition = '';
    }
  }

  // Start the slide on click, while the next page loads, so the nav answers at once.
  document.addEventListener('astro:before-preparation', (event) => {
    const to = event.to.pathname.replace(/\/$/, '');
    const target = Array.from(document.querySelectorAll<HTMLAnchorElement>('.site-header .tab')).find(
      (tab) => tab.pathname.replace(/\/$/, '') === to,
    );
    if (!target) return;
    document.querySelectorAll('.site-header .tab').forEach((tab) => tab.removeAttribute('aria-current'));
    target.setAttribute('aria-current', 'page');
    placeIndicator(true);
  });

  // Astro keeps the header by moving its node into the new page, and moving a node
  // cancels its running CSS transitions (the underline would jump to the end).
  // So remember where the underline is right before the swap and resume from there.
  let resumeFrom: { x: number; width: number } | null = null;
  document.addEventListener('astro:before-swap', () => {
    const indicator = document.querySelector<HTMLElement>('.tabs-indicator');
    if (!indicator?.classList.contains('is-visible')) return;
    const style = getComputedStyle(indicator);
    resumeFrom = { x: new DOMMatrix(style.transform).m41, width: parseFloat(style.width) };
  });

  // Then confirm against the new page once it is in (also covers back/forward).
  document.addEventListener('astro:after-swap', () => {
    syncActiveTab();
    const indicator = document.querySelector<HTMLElement>('.tabs-indicator');
    if (indicator && resumeFrom) {
      indicator.style.transition = 'none';
      indicator.style.transform = `translateX(${resumeFrom.x}px)`;
      indicator.style.width = `${resumeFrom.width}px`;
      void indicator.offsetWidth;
      indicator.style.transition = '';
    }
    resumeFrom = null;
    placeIndicator(true);
  });

  let ready = false;
  document.addEventListener('astro:page-load', () => {
    syncActiveTab();
    placeIndicator(ready);
    if (ready) return;
    ready = true;
    // Widths change once the house fonts load, and on resize.
    document.fonts.ready.then(() => placeIndicator(false));
    const nav = document.querySelector('.site-header .tabs');
    // Only a real width change repositions without animation; anything else would
    // cut a slide in progress short.
    let lastWidth = 0;
    if (nav)
      new ResizeObserver(([entry]) => {
        const width = Math.round(entry.contentRect.width);
        if (width === lastWidth) return;
        lastWidth = width;
        placeIndicator(false);
      }).observe(nav);
  });
</script>
