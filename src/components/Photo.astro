---
import fs from 'node:fs';
import path from 'node:path';
import { withBase } from '../lib/url';

interface Props {
  file: string;
  label: string;
  class?: string;
  transitionName?: string;
  loading?: 'eager' | 'lazy';
}

const { file, label, class: className = '', transitionName, loading = 'lazy' } = Astro.props;

// Show the real image as soon as it exists in /public, otherwise a labelled placeholder.
const exists = fs.existsSync(path.join(process.cwd(), 'public', file));
---

{
  /* `transition:name` is only rendered when a name is given: with an undefined
     value Astro still generates a unique view-transition-name, which lifts every
     photo out of its container (and its overflow clip) during page transitions. */
}
{
  exists ? (
    transitionName ? (
      <img class:list={['photo', className]} src={withBase(file)} alt={label} loading={loading} decoding="async" transition:name={transitionName} />
    ) : (
      <img class:list={['photo', className]} src={withBase(file)} alt={label} loading={loading} decoding="async" />
    )
  ) : transitionName ? (
    <div class:list={['photo', 'photo-placeholder', className]} role="img" aria-label={label} transition:name={transitionName}>
      <span>[Photo] {label}</span>
    </div>
  ) : (
    <div class:list={['photo', 'photo-placeholder', className]} role="img" aria-label={label}>
      <span>[Photo] {label}</span>
    </div>
  )
}
