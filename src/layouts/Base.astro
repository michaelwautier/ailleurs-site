---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  themeStyle: string;
  scheme: 'light' | 'dark';
  isHome?: boolean;
}

const { title, description = 'Quatre petites maisons à univers à La Réunion : Japon, créole, Maroc, Bali.', themeStyle, scheme, isHome = false } = Astro.props;
---

<!doctype html>
<html lang="fr" style={`${themeStyle};color-scheme:${scheme}`} data-home={isHome ? 'true' : 'false'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300&family=Italiana&family=Manrope:wght@400;500;600&family=Marcellus&family=Noto+Naskh+Arabic:wght@400;500&family=Noto+Sans+Balinese&family=Shippori+Mincho:wght@400;600&display=swap"
    />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <slot />
    <script>
      // The view transition snapshots the new page right after the swap. If its hero
      // photo is not loaded yet, the old photo fades into an empty box and the new one
      // pops in afterwards. Load and decode it first (capped, so a slow network never
      // blocks navigation for long).
      document.addEventListener('astro:before-preparation', (event) => {
        const load = event.loader;
        event.loader = async () => {
          await load();
          const src = event.newDocument?.querySelector('.hero-photo img')?.getAttribute('src');
          if (!src) return;
          const img = new Image();
          img.src = new URL(src, event.to).href;
          await Promise.race([img.decode().catch(() => {}), new Promise((r) => setTimeout(r, 1500))]);
        };
      });

      // Slow, eased scroll for in-page anchors (native smooth scroll is too quick).
      const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

      function scrollToY(target: number) {
        const start = window.scrollY;
        const distance = target - start;
        const duration = Math.min(1400, Math.max(700, Math.abs(distance) * 0.45));
        const t0 = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - t0) / duration);
          window.scrollTo({ top: start + distance * easeInOut(t), behavior: 'instant' });
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }

      // Capture phase so this runs before the view-transition router handles the click.
      document.addEventListener(
        'click',
        (event) => {
          const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
          if (!link || event.defaultPrevented || event.metaKey || event.ctrlKey) return;
          const id = decodeURIComponent(link.hash.slice(1));
          const target = id ? document.getElementById(id) : null;
          if (!target) return;
          event.preventDefault();
          event.stopPropagation();
          history.pushState(history.state, '', link.hash);
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) target.scrollIntoView();
          else {
            const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
            scrollToY(Math.max(0, target.getBoundingClientRect().top + window.scrollY - margin));
          }
        },
        { capture: true },
      );
    </script>
  </body>
</html>
